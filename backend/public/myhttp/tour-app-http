server {
    listen 80; # Ou 8900 si tu préfères garder ce port temporairement
    server_name bsalvan.freeboxos.fr;

    root /var/www/tour-app/frontend/dist;
    index index.html index.php;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api {
        alias /var/www/tour-app/backend/public;
        try_files $uri $uri/ @php_backend;
    }

    location @php_backend {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/tour-app/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/tour-app/backend/public;
    }

    location ~ ^/api/.+\.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/tour-app/backend/public$fastcgi_script_name;
    }
}
